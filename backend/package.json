{
  "name": "hms-backend",
  "version": "1.0.0",
  "description": "Healthcare Management System Backend API",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:setup": "node database/setup.js",
    "db:reset": "node database/scripts/resetDatabase.js",
     "db:migrate": "node database/scripts/runMigrations.js",
    "db:seed": "node database/scripts/seedDatabase.js",
    "db:health": "node -e \"require('./database/connection').checkHealth().then(console.log)\"",
    "test": "jest",
    "test:db": "jest tests/database.test.js",
    "lint": "eslint .",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:models": "jest tests/unit/models",
    "test:controllers": "jest tests/unit/controllers",
    "test:middleware": "jest tests/unit/middleware"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "morgan": "^1.10.0",
    "express-rate-limit": "^6.10.0"
  },
  "devDependencies": {
    "msw": "^2.12.7",
    "nodemon": "^2.0.22",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.53.0",
    "@types/jest": "^29.5.5",
    "jest-mock-extended": "^3.0.5",
    "testcontainers": "^10.6.0"
  }
}
